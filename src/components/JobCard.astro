---
import type { Job } from '../lib/categories';

export interface Props {
  job: Job;
}

const { job } = Astro.props;
const f = job.featured;
---

<div class:list={['job-card', { featured: f }]}>
  <div class="job-badges">
    <span class="badge badge-salary">{job.hourlyMin && job.hourlyMax ? `$${job.hourlyMin} - $${job.hourlyMax}/hr` : job.salaryMin ? `$${(job.salaryMin/1000).toFixed(0)}K` : 'Competitive'}{job.salaryMax && job.salaryMax !== job.salaryMin ? ` - $${(job.salaryMax/1000).toFixed(0)}K` : ''}</span>
    {job.referralBonus > 0 && (
      <span class:list={['badge', job.referralBonus >= 1000 ? 'badge-bonus-high' : 'badge-bonus']}>${job.referralBonus} bonus</span>
    )}
  </div>
  <a href={`/jobs/${job.slug}`} class="job-title-link">
    <h3 class="job-title">{job.title}</h3>
  </a>
  <div class="job-meta">
    <span>{job.type}</span>
    {job.openings > 0 && <><span>·</span><span>{job.openings} opening{job.openings > 1 ? 's' : ''}</span></>}
  </div>
  {job.skills.length > 0 && (
    <div class="job-skills">
      {job.skills.slice(0, 5).map(s => <span class:list={['skill-tag', { 'skill-tag-featured': f }]}>{s}</span>)}
    </div>
  )}
  <a href={job.affiliateUrl} target="_blank" rel="noopener noreferrer" class:list={['btn-apply', { 'btn-apply-featured': f }]}>
    Apply Now →
  </a>
</div>

<style>
  .job-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--color-bg-card, #fff);
    border: 2px solid var(--color-border, #e5e5e5);
    border-radius: 0;
    transition: box-shadow 0.3s var(--ease-smooth, cubic-bezier(0.22,1,0.36,1));
  }
  .job-card.featured {
    background: var(--color-primary, #004cf0);
    border: none;
  }
  .job-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    font-family: var(--font-mono, 'Space Mono', monospace);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-radius: 0;
  }
  .badge-salary { background: var(--color-accent-emerald-light, #e6fae8); color: var(--color-accent-emerald, #04c432); }
  .badge-bonus { background: var(--color-accent-amber-light, #fef3c7); color: var(--color-accent-amber, #f59e0b); }
  .badge-bonus-high { background: var(--color-accent-amber-light, #fef3c7); color: #92400e; }
  .job-card.featured .badge { background: rgba(255,255,255,0.2); color: white; }
  .job-title-link { text-decoration: none; }
  .job-title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text, #090909);
    font-family: var(--font-heading, 'Hanken Grotesk', sans-serif);
    line-height: 1.3;
  }
  .job-card.featured .job-title { color: white; }
  .job-meta {
    font-size: 0.8125rem;
    color: var(--color-text-secondary, #444);
    display: flex;
    gap: 0.375rem;
  }
  .job-card.featured .job-meta { color: rgba(255,255,255,0.7); }
  .job-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .skill-tag {
    display: inline-flex;
    padding: 4px 10px;
    background: var(--color-primary-light, #e0ebff);
    color: var(--color-primary, #004cf0);
    font-family: var(--font-mono, 'Space Mono', monospace);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .skill-tag-featured {
    background: rgba(255,255,255,0.15);
    color: white;
  }
  .btn-apply {
    margin-top: 0.5rem;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-mono, 'Space Mono', monospace);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    cursor: pointer;
    border-radius: 0;
    border: 2px solid var(--color-primary, #004cf0);
    background: var(--color-primary, #004cf0);
    color: white;
    transition: all 0.2s var(--ease-smooth, cubic-bezier(0.22,1,0.36,1));
  }
  .btn-apply-featured {
    border: none;
    background: white;
    color: var(--color-primary, #004cf0);
  }
</style>
